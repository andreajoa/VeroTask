# Public app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VeroTask

# Database (Neon PostgreSQL)
DATABASE_URL=

# Authentication and scheduled jobs
AUTH_SECRET=
CRON_SECRET=

# Private VeroTask Control Center
# ADMIN_PASSWORD_HASH format: scrypt$<saltHex>$<64-byte-hashHex>
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Audit/privacy cryptography
# AUDIT_ENCRYPTION_KEY must be 32 bytes (64 hex characters or base64-encoded 32 bytes).
AUDIT_ENCRYPTION_KEY=
AUDIT_HASH_SECRET=
UNSUBSCRIBE_SECRET=

# Stripe payments and provider subscriptions
# VeroTask does NOT use Stripe Connect. Customers pay only the VeroTask booking fee in USD.
# The service amount is paid directly by the customer to the independent professional.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional stable recurring USD prices. If absent, Checkout creates recurring USD price_data inline.
STRIPE_PRICE_PRO_USD_MONTHLY=
STRIPE_PRICE_ELITE_USD_MONTHLY=

# Email / CRM
# Use a verified VeroTask sending domain in production.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=VeroTask <notifications@example.com>
# Required before promotional email (CAN-SPAM physical postal identity).
MARKETING_POSTAL_ADDRESS=

# Private booking evidence storage (Cloudflare R2 or another S3-compatible provider)
# Evidence objects remain private; VeroTask creates short-lived signed upload/view URLs.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Webmaster verification / indexing
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AHREFS_SITE_VERIFICATION=
INDEXNOW_KEY=

# Optional maps provider. US service-address geocoding uses the public Census Geocoder by default.
MAPS_API_KEY=

# Optional AI layer used for request classification/matching. Keep provider-agnostic.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
