# Public app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VeroTask

# Database (Neon PostgreSQL)
DATABASE_URL=

# Authentication
AUTH_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ELITE_MONTHLY=

# Optional email provider
RESEND_API_KEY=
EMAIL_FROM=VeroTask <notifications@example.com>

# Optional object storage (R2/S3 compatible)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional maps/geocoding provider. The core product must continue to work without this key.
MAPS_API_KEY=

# Optional AI layer used for request classification/matching. Keep provider-agnostic.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
