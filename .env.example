# Public app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VeroTask

# Database (Neon PostgreSQL)
DATABASE_URL=

# Authentication and scheduled jobs
AUTH_SECRET=
CRON_SECRET=

# Private VeroTask Control Center
# ADMIN_PASSWORD_HASH format: scrypt$<saltHex>$<64-byte-hashHex>
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Audit/privacy cryptography
# AUDIT_ENCRYPTION_KEY must be 32 bytes (64 hex characters or base64-encoded 32 bytes).
AUDIT_ENCRYPTION_KEY=
AUDIT_HASH_SECRET=
UNSUBSCRIBE_SECRET=

# Stripe marketplace payments and provider subscriptions
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ELITE_MONTHLY=

# Email / CRM
# RESEND_WEBHOOK_SECRET verifies delivery/open/click/bounce/complaint events.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=VeroTask <notifications@example.com>
# Required before sending promotional email in production (CAN-SPAM footer identity).
MARKETING_POSTAL_ADDRESS=

# Private booking evidence storage (Cloudflare R2 or another S3-compatible provider)
# Evidence objects are not public. VeroTask creates short-lived signed upload/view links.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Webmaster verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AHREFS_SITE_VERIFICATION=
INDEXNOW_KEY=

# Optional paid maps provider. US service-address geocoding uses the public Census Geocoder by default.
MAPS_API_KEY=

# Optional AI layer used for request classification/matching. Keep provider-agnostic.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
