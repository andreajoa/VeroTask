# Public app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VeroTask

# Database (Neon PostgreSQL)
DATABASE_URL=
# DATABASE_DRIVER=postgres is only for local node-postgres development.
DATABASE_DRIVER=

# Authentication and scheduled jobs
AUTH_SECRET=
CRON_SECRET=

# Private VeroTask Control Center
# ADMIN_PASSWORD_HASH format: scrypt$<saltHex>$<64-byte-hashHex>
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Audit/privacy cryptography
# AUDIT_ENCRYPTION_KEY must be 32 bytes (64 hex characters or base64-encoded 32 bytes).
AUDIT_ENCRYPTION_KEY=
AUDIT_HASH_SECRET=
UNSUBSCRIBE_SECRET=

# Stripe: VeroTask collects the booking fee and provider-plan subscriptions.
# The service amount itself is paid directly between customer and provider.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ELITE_MONTHLY=

# Email / CRM (Resend)
RESEND_API_KEY=
# Verifies delivery/open/click/bounce/complaint webhook events.
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=VeroTask <notifications@example.com>
# Required before promotional CRM email is enabled in production.
MARKETING_POSTAL_ADDRESS=

# Private booking evidence storage (Cloudflare R2 or another S3-compatible provider)
# Evidence objects are private. VeroTask generates short-lived signed upload/view URLs.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Brazilian address geocoding / service-location evidence
GOOGLE_MAPS_API_KEY=

# Webmaster verification / discoverability
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AHREFS_SITE_VERIFICATION=
INDEXNOW_KEY=

# Optional AI layer used for request classification/matching. Keep provider-agnostic.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
